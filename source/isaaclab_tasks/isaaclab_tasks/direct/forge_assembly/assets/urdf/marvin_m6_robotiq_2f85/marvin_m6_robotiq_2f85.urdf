      <geometry><mesh filename="package://marvin_m6_robotiq_2f85/meshes/outer_knuckle_fine.STL" /></geometry>
      <material name="gripper_mat"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
