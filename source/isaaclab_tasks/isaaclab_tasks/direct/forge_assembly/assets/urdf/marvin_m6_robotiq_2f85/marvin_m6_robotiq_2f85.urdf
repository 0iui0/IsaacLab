    <limit lower="-1.5708" upper="1.5708" effort="18" velocity="3.1416" />
  </joint>

  <!-- ==================== FORCE SENSOR ==================== -->
  <!-- Virtual force sensor link between flange and gripper.
       Minimal mass so it doesn't affect dynamics.
       Link7_R flange approaches -Y direction. Offset along -Y by 0.1m.
       Rotation rpy=[pi/2, 0, 0] maps Robotiq Z-axis to Link7_R -Y-axis. -->

  <link name="force_sensor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.03" length="0.015" /></geometry>
      <material name="sensor_mat"><color rgba="0.9 0.9 0.0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.03" length="0.015" /></geometry>
    </collision>
  </link>
  <joint name="flange_to_force_sensor" type="fixed">
    <origin xyz="0 -0.1 0" rpy="1.5708 0 0" />
    <parent link="Link7_R" /><child link="force_sensor" />
  </joint>

  <!-- ==================== ROBOTIQ 2F-85 ==================== -->
  <!-- Official Robotiq 2F-85 URDF with real STL meshes.
       Source: https://github.com/a-price/robotiq_arg85_description

       Joint layout:
         finger_joint (drive) -> left_outer_knuckle -> [fixed] left_outer_finger
         left_inner_knuckle_joint (mimic +1) -> left_inner_knuckle -> left_inner_finger_joint (mimic -1) -> left_inner_finger
         right_outer_knuckle_joint (mimic -1) -> right_outer_knuckle -> [fixed] right_outer_finger
         right_inner_knuckle_joint (mimic -1) -> right_inner_knuckle -> right_inner_finger_joint (mimic +1) -> right_inner_finger
  -->

  <link name="robotiq_85_base_link">
    <inertial>
      <origin xyz="0.00021987 -2.3546E-10 0.030163" rpy="0 0 0" />
      <mass value="0.30915" />
      <inertia ixx="0.00028972" ixy="-5.7879E-10" ixz="-1.8543E-06" iyy="0.00030737" iyz="1.682E-12" izz="0.00019914" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_robotiq_2f85/meshes/robotiq_85_base_link_fine.STL" /></geometry>
      <material name="gripper_mat"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_robotiq_2f85/meshes/robotiq_85_base_link_coarse.STL" /></geometry>
    </collision>
  </link>
  <joint name="force_sensor_to_gripper" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="force_sensor" /><child link="robotiq_85_base_link" />
  </joint>

  <!-- LEFT OUTER KNUCKLE (drive) -->
  <link name="left_outer_knuckle">
    <inertial>
      <origin xyz="0.0178331863169983 3.68915177224286E-11 0.0021442477325704" rpy="0 0 0" />
      <mass value="0.00684838849434396" />
      <inertia ixx="2.66832029033166E-07" ixy="1.66142314639824E-15" ixz="1.45945633322873E-07" iyy="1.3889233257419E-06" iyz="2.82951161241588E-15" izz="1.26603336914415E-06" />
    </inertial>
    <visual>
