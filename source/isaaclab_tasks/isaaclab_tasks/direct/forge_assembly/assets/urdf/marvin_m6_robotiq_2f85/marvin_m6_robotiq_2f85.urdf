<?xml version="1.0" encoding="utf-8"?>
<robot name="marvin_m6_robotiq_2f85">
  <!--
    Marvin M6-S-R (7-DOF) + Force Sensor + Robotiq 2F-85 combined URDF.

    Kinematic chain:
      Base_R -> Joint1-7_R -> Link7_R -> [fixed] force_sensor -> [fixed] robotiq_85_base_link
        -> finger_joint -> left_outer_knuckle -> [fixed] left_outer_finger
        -> [mimic] left_inner_knuckle -> left_inner_finger
        -> [mimic] right_outer_knuckle -> [fixed] right_outer_finger
        -> [mimic] right_inner_knuckle -> right_inner_finger

    M6 meshes: package://marvin_m6_robotiq_2f85/meshes/{Base_R,Link1-7_R}.STL
    Robotiq meshes: package://marvin_m6_robotiq_2f85/meshes/{robotiq_85_base_link,outer_knuckle,outer_finger,inner_knuckle,inner_finger}_{fine,coarse}.STL
  -->

  <!-- ==================== M6 RIGHT ARM (7-DOF) ==================== -->

  <link name="Base_R">
    <inertial>
      <origin xyz="0.00032267 4.798E-05 0.04066353" rpy="0 0 0" />
      <mass value="1.1962" />
      <inertia ixx="0.00107329" ixy="-1.68E-06" ixz="-1.05E-05" iyy="0.00107003" iyz="-3.43E-06" izz="0.00127315" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_robotiq_2f85/meshes/Base_R.STL" /></geometry>
      <material name="base_mat"><color rgba="0.5 0.5 0.5 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_robotiq_2f85/meshes/Base_R.STL" /></geometry>
    </collision>
  </link>

  <link name="Link1_R">
    <inertial>
      <origin xyz="0.00002347 0.00557150 -0.03075998" rpy="0 0 0" />
      <mass value="1.9705" />
      <inertia ixx="0.00492293" ixy="0.00000550" ixz="0.00000193" iyy="0.00526513" iyz="0.00033232" izz="0.00188107" />
    </inertial>
    <visual>
