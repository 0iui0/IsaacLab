<?xml version="1.0" encoding="utf-8"?>
<!-- Marvin M6-S-R (7-DOF) Arm URDF with force_sensor interface.
     Based on original Marvin-M6-S-R-CCS-696-V4.0.urdf from manufacturer.
     Pure arm with virtual force_sensor link at flange.

     Kinematic chain:
       Base_R -> Joint1-7_R -> Link7_R -> [fixed] force_sensor
-->
<robot name="marvin_m6_arm">
  <!-- ==================== BASE_R ==================== -->
  <link name="Base_R">
    <inertial>
      <origin xyz="0.00032267 4.798E-05 0.04066353" rpy="0 0 0" />
      <mass value="1.1962" />
      <inertia ixx="0.00107329" ixy="-1.68E-06" ixz="-1.05E-05" iyy="0.00107003" iyz="-3.43E-06" izz="0.00127315" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Base_R.STL" /></geometry>
      <material name=""><color rgba="1 0 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Base_R.STL" /></geometry>
    </collision>
  </link>

  <!-- ==================== LINK1_R ==================== -->
  <link name="Link1_R">
    <inertial>
      <origin xyz="0.00002347 0.00557150 -0.03075998" rpy="0 0 0" />
      <mass value="1.9705" />
      <inertia ixx="0.00492293" ixy="0.00000550" ixz="0.00000193" iyy="0.00526513" iyz="0.00033232" izz="0.00188107" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link1_R.STL" /></geometry>
      <material name=""><color rgba="0 1 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link1_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint1_R" type="revolute">
    <origin xyz="0 0 0.1745" rpy="0 0 0" />
    <parent link="Base_R" />
    <child link="Link1_R" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1067" upper="3.1067" effort="108" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK2_R ==================== -->
  <link name="Link2_R">
    <inertial>
      <origin xyz="0.00013483 0.06170460 0.00950639" rpy="0 0 0" />
      <mass value="2.24398" />
      <inertia ixx="0.01194933" ixy="0.00000336" ixz="0.00000091" iyy="0.00361581" iyz="-0.00132804" izz="0.01098356" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link2_R.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link2_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint2_R" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <parent link="Link1_R" />
    <child link="Link2_R" />
    <axis xyz="0 0 1" />
    <limit lower="-2.0944" upper="2.0944" effort="108" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK3_R ==================== -->
  <link name="Link3_R">
    <inertial>
      <origin xyz="0.00968562 0.00246599 -0.04627302" rpy="0 0 0" />
      <mass value="1.9242" />
      <inertia ixx="0.00718224" ixy="0.00004413" ixz="0.00089552" iyy="0.00762563" iyz="0.00022096" izz="0.00178597" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link3_R.STL" /></geometry>
      <material name=""><color rgba="1 0 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link3_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint3_R" type="revolute">
    <origin xyz="0 0.287 0" rpy="-1.5708 0 0" />
    <parent link="Link2_R" />
    <child link="Link3_R" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1067" upper="3.1067" effort="66" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK4_R ==================== -->
  <link name="Link4_R">
    <inertial>
      <origin xyz="0.00850411 -0.04718223 0.00941509" rpy="0 0 0" />
      <mass value="1.6085" />
      <inertia ixx="0.00580480" ixy="-0.00066669" ixz="-0.00012722" iyy="0.00223807" iyz="0.00070523" izz="0.00533060" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link4_R.STL" /></geometry>
      <material name=""><color rgba="0 1 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link4_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint4_R" type="revolute">
    <origin xyz="0.018 0 0" rpy="-1.5708 0 3.1416" />
    <parent link="Link3_R" />
    <child link="Link4_R" />
    <axis xyz="0 0 1" />
    <limit lower="-2.5307" upper="1.0472" effort="66" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK5_R ==================== -->
  <link name="Link5_R">
    <inertial>
      <origin xyz="-0.00051127 -0.00101064 -0.11271739" rpy="0 0 0" />
      <mass value="2.0883" />
      <inertia ixx="0.00626603" ixy="0.00004009" ixz="-0.00005338" iyy="0.00564387" iyz="0.00006193" izz="0.00243632" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link5_R.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link5_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint5_R" type="revolute">
    <origin xyz="0.018 -0.314 0" rpy="-1.5708 0 3.1416" />
    <parent link="Link4_R" />
    <child link="Link5_R" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1067" upper="3.1067" effort="18" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK6_R ==================== -->
  <link name="Link6_R">
    <inertial>
      <origin xyz="0.00032659 -0.00531336 0.00030182" rpy="0 0 0" />
      <mass value="0.72496" />
      <inertia ixx="0.00046040" ixy="-0.00000189" ixz="-0.00000083" iyy="0.00051716" iyz="-0.00000346" izz="0.00042521" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link6_R.STL" /></geometry>
      <material name=""><color rgba="1 0 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link6_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint6_R" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 0" />
    <parent link="Link5_R" />
    <child link="Link6_R" />
    <axis xyz="0 0 1" />
    <limit lower="-1.0472" upper="1.0472" effort="18" velocity="3.1416" />
  </joint>

  <!-- ==================== LINK7_R (Flange) ==================== -->
  <link name="Link7_R">
    <inertial>
      <origin xyz="-0.00009108 -0.03153255 0.00889371" rpy="0 0 0" />
      <mass value="0.68606" />
      <inertia ixx="0.00173687" ixy="-0.00000345" ixz="-0.00000116" iyy="0.00089035" iyz="0.00030680" izz="0.00139406" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link7_R.STL" /></geometry>
      <material name=""><color rgba="0 1 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://marvin_m6_arm/meshes/Link7_R.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint7_R" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 0" />
    <parent link="Link6_R" />
    <child link="Link7_R" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="18" velocity="3.1416" />
  </joint>

  <!-- ==================== FORCE SENSOR INTERFACE ==================== -->
  <!-- Force sensor represented as cylinder (63mm diameter, 33mm thickness).
       Positioned at Link7_R flange end, ready for gripper attachment.

       Cylinder parameters:
         - diameter: 63mm → radius = 31.5mm = 0.0315m
         - thickness: 33mm → length = 0.033m

       The force_sensor cylinder's top face (Z+ direction) is the gripper attachment point.
       When attaching gripper, create Fixed Joint from force_sensor to gripper base.
-->
  <link name="force_sensor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.0315" length="0.033" /></geometry>
      <material name="sensor_mat"><color rgba="0.9 0.9 0.0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.0315" length="0.033" /></geometry>
    </collision>
  </link>
  <joint name="Link7_to_force_sensor" type="fixed">
    <!-- Offset from Link7_R origin to force_sensor center.
         The cylinder sits at the flange end, with its center at half-length offset.
         Offset = 0.02m (flange thickness estimate) + 0.0165m (half cylinder height) = 0.0365m
         Adjusted to place cylinder's bottom face at flange surface. -->
    <origin xyz="0 0 0.0365" rpy="0 0 0" />
    <parent link="Link7_R" />
    <child link="force_sensor" />
  </joint>

</robot>